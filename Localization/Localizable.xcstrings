            "value" : "Päivittäinen insuliinin enimmäismäärä on saavutettu. Kokeile pienempää määrää tai nosta rajaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite maximale d'insuline par jour est atteinte. Veuillez essayer une quantité plus faible ou augmenter la limite"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The max daily insulin limit is reached. Please try a lower amount or increase the limit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il limite massimo di insulina giornaliero è stato raggiunto. Provare con una quantità inferiore o aumentare il limite"
