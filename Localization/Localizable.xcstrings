    "Your daily basal limit has been reached. Please contact your Dana distributer to increase the limit" : {
      "comment" : "Alert body for basalMax",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد تم الوصول إلى الحد الأساسي اليومي. يرجى الاتصال بموزع دانا الخاص بك لزيادة الحد المسموح به"
