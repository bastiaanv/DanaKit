          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseja receber uma notificação quando a bomba for desconectada por mais tempo por um período específico?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
