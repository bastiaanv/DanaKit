        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä täyttömenetelmä on tarkoitettu vain silloin, kun pumppu ei pysty täyttämään säiliötä tai täyttämään kanyylia."
