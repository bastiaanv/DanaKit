          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den dagliga maxgränsen för insulin har uppnåtts. Försök med en lägre mängd eller öka gränsen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimum günlük insülin limitine ulaşıldı. Lütfen daha düşük bir miktar deneyin veya limiti artırın"
