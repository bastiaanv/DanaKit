    "Do you wish to receive a notification when the pump is longer disconnected for a specific time?" : {
      "comment" : "body disconnect reminder sheet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل ترغب في تلقي إشعار عندما تكون المضخة مفصولة لفترة زمنية محددة؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ønsker du at modtage en meddelelse, når pumpen er frakoblet i et bestemt tidsrum?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie eine Benachrichtigung erhalten, wenn die Pumpe für eine bestimmte Zeit nicht angeschlossen ist?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Desea recibir una notificación cuando la bomba esté desconectada durante un tiempo determinado?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko saada ilmoituksen, kun pumppu on pidempään poissa käytöstä tietyn ajan?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhaitez-vous recevoir une notification lorsque la pompe est déconnectée pour une durée déterminée ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Do you wish to receive a notification when the pump is longer disconnected for a specific time?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Do you wish to receive a notification when the pump is longer disconnected for a specific time?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si desidera ricevere una notifica quando la pompa viene scollegata per un periodo di tempo specifico?"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Do you wish to receive a notification when the pump is longer disconnected for a specific time?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je een melding ontvangen als de pomp voor een bepaalde tijd is losgekoppeld?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy chcesz otrzymywać powiadomienia, gdy pompa zostanie odłączona na określony czas?"
          }
        },
        "pt" : {
          "stringUnit" : {
