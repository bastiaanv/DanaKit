    },
    "The pump has detected an issue with its chaft. Please remove the reservoir, check everything and try again" : {
      "comment" : "Alert body for checkShaft",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتشفت المضخة وجود مشكلة في عمودها. يرجى إزالة الخزان وفحص كل شيء والمحاولة مرة أخرى"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čerpadlo zjistilo problém s řetězem. Vyjměte nádržku, vše zkontrolujte a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pumpen har opdaget et problem med sit skaft. Fjern venligst reservoiret, tjek alt og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pumpe hat ein Problem mit ihrem Schacht festgestellt. Bitte entfernen Sie das Reservoir, überprüfen Sie alles und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pump has detected an issue with its chaft. Please remove the reservoir, check everything and try again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bomba ha detectado un problema con su eje. Por favor, retire el depósito, compruébelo todo e inténtelo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
