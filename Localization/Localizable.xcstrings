          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O expirare a bolusului este activă. Ciclul de buclă nu poate fi finalizat până când expirarea nu este inactivă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тайм-аут болюса активен. Цикл петли не может быть завершен пока тайм-аут активен"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časový limit pre podanie bolusu je aktívny. Cyklus slučky sa nemôže dokončiť, kým nie je časový limit neaktívny"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
